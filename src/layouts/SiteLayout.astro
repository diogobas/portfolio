---
import '../styles/global.css';
import { resume } from '../data/resume';

interface Props {
  title: string;
  description?: string;
  path?: string;
  profilePage?: boolean;
}

const {
  title,
  description = 'Professional portfolio of Diogo Bastos, a senior full-stack software engineer.',
  path = '/',
  profilePage = false,
} = Astro.props;

const siteUrl = (import.meta.env.PUBLIC_SITE_URL || 'https://diogobastos.pages.dev').replace(
  /\/$/,
  ''
);
const pageUrl = new URL(path, `${siteUrl}/`).href;
const personId = `${siteUrl}/#person`;
const personSchema = {
  '@id': personId,
  '@type': 'Person',
  name: resume.identity.name,
  jobTitle: resume.identity.role,
  email: `mailto:${resume.identity.email}`,
  url: resume.identity.portfolio,
  address: {
    '@type': 'PostalAddress',
    addressCountry: resume.identity.location,
  },
  sameAs: [resume.identity.linkedin, resume.identity.github],
  knowsAbout: resume.skills.flatMap((group) => group.items),
};
const pageSchema = profilePage
  ? {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'ProfilePage',
          '@id': `${pageUrl}#profile-page`,
          url: pageUrl,
          name: title,
          description,
          mainEntity: { '@id': personId },
        },
        personSchema,
      ],
    }
  : { '@context': 'https://schema.org', ...personSchema };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0b1120" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Diogo Bastos" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:url" content={pageUrl} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
  </body>
</html>
