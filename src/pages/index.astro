---
import ExperienceList from '../components/ExperienceList.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { experiences, profile, socialLinks } from '../data/profile';
---

<SiteLayout title="Diogo Bastos | Senior Full-Stack Software Engineer">
  <div class="page-shell">
    <header class="intro" aria-label="Introduction">
      <a class="brand" href="#about">
        <span class="brand-name">{profile.name}</span>
        <span class="brand-role">{profile.role}</span>
      </a>

      <p class="hero-copy">I build thoughtful, reliable learning technology.</p>

      <nav class="section-nav" aria-label="In-page navigation">
        <a href="#about">About</a>
        <a href="#experience">Experience</a>
        <a href="#contact">Contact</a>
      </nav>

      <ul class="social-links" aria-label="Social links">
        {
          socialLinks.map((link) => (
            <li>
              <a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noreferrer' : undefined}>
                <span class="sr-only">{link.label}</span>
                <span aria-hidden="true">{link.icon}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </header>

    <main class="content">
      <section id="about" aria-labelledby="about-title">
        <p class="section-kicker">01</p>
        <h1 id="about-title">About</h1>
        <div class="prose">
          <p>
            I’m a senior full-stack software engineer with 20 years of experience building scalable web
            applications in collaborative, Agile teams. I enjoy turning complex product needs into clear,
            maintainable experiences for the people who rely on them.
          </p>
          <p>
            My work spans React and TypeScript on the frontend, Node.js and Java microservices on the
            backend, and the cloud and delivery practices that connect them. I care deeply about quality,
            accessibility, observability, and the small details that make software dependable.
          </p>
          <p>
            I’m currently helping build digital curriculum and career-readiness experiences at Pearson’s
            eDynamic Learning. Previously, I spent several years creating learning technology at HMH and
            Neovation Learning Solutions.
          </p>
        </div>
      </section>

      <section id="experience" aria-labelledby="experience-title">
        <p class="section-kicker">02</p>
        <h2 id="experience-title">Experience</h2>
        <ExperienceList experiences={experiences} />
      </section>

      <section id="contact" aria-labelledby="contact-title" class="contact-section">
        <p class="section-kicker">03</p>
        <h2 id="contact-title">Let’s connect</h2>
        <div class="prose">
          <p>
            I’m always happy to connect about software engineering, learning technology, and thoughtful
            product development.
          </p>
        </div>
        <a class="text-link" href={`mailto:${profile.email}`}>{profile.email}</a>
      </section>
    </main>
  </div>
</SiteLayout>
