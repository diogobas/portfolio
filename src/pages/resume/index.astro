---
import { profile, socialLinks } from '../../data/profile';
import { resume } from '../../data/resume';
import SiteLayout from '../../layouts/SiteLayout.astro';
---

<SiteLayout
  title="Résumé | Diogo Bastos"
  description="Public résumé for Diogo Bastos, a senior full-stack software engineer."
  path="/resume/"
>
  <main id="main-content" class="resume-page">
    <a class="archive-back-link" href="/">← Back to home</a>

    <header class="resume-header">
      <div>
        <p class="section-kicker">Public résumé</p>
        <h1>{profile.name}</h1>
        <p>{profile.role}</p>
      </div>
      <div class="resume-actions">
        <a class="text-link" href="/resume/diogo-bastos-resume.pdf" download>Download PDF <span aria-hidden="true">↓</span></a>
        <a class="text-link" href={`mailto:${profile.email}`}>{profile.email}</a>
      </div>
    </header>

    <section class="resume-section" aria-labelledby="resume-summary">
      <h2 id="resume-summary">Profile</h2>
      <p>{resume.summary}</p>
    </section>

    <section class="resume-section" aria-labelledby="resume-experience">
      <h2 id="resume-experience">Experience</h2>
      <ol class="resume-experience-list">
        {
          resume.experience.map((item) => (
            <li>
              <p class="experience-period">{item.period}</p>
              <h3>{item.role} <span>@ {item.company}</span></h3>
              <p>{item.details}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="resume-section" aria-labelledby="resume-skills">
      <h2 id="resume-skills">Core skills</h2>
      <ul class="technology-list" aria-label="Core skills">
        {resume.skills.map((skill) => <li>{skill}</li>)}
      </ul>
    </section>

    <section class="resume-section" aria-labelledby="resume-education">
      <h2 id="resume-education">Education</h2>
      <ul class="resume-education-list">
        {resume.education.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="resume-section resume-contact" aria-labelledby="resume-contact">
      <h2 id="resume-contact">Contact</h2>
      <p>This public version intentionally includes only professional contact channels.</p>
      <ul>
        {socialLinks.filter((link) => link.label !== 'Email').map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </section>
  </main>
</SiteLayout>
